# Python
backend/venv/
__pycache__/
*.pyc
.pytest_cache/

# Backend runtime data: uploads, analysis outputs, sqlite db, and every
# downloaded/fetched dataset (LEVIR-CD, OSCD, any scripts/fetch_* output,
# present or future) -- all documented as scripted re-downloads. Ignore
# every subdirectory of data/ by default and explicitly re-allow the few
# small files that should be tracked.
backend/data/*.db
backend/data/settings.json
backend/data/*/
!backend/data/population/
backend/data/population/*
!backend/data/population/.gitkeep

# Model weights (downloaded/trained separately, see README / HANDOFF.md)
backend/models/*
!backend/models/.gitkeep

# Node
frontend/node_modules/
frontend/dist/

# "Load Wayanad demo" button assets -- same raw GeoTIFFs as
# backend/data/wayanad/, copied here so the browser can fetch them as
# static files and feed them through the normal upload flow with no new
# backend route. ~12 MB, gitignored like the backend copy; copy them over
# locally (cp backend/data/wayanad/{before,after}.tif frontend/public/demo/
# wayanad_{before,after}.tif) to use the demo button. Hidden/disabled
# gracefully if missing.
frontend/public/demo/*.tif

# Playwright artifacts
frontend/test-results/
frontend/playwright-report/
frontend/playwright/.cache/
frontend/blob-report/

# Env files (keep .env.example)
.env
backend/.env
frontend/.env

# Editor / OS
.DS_Store
