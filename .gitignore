# Python
backend/venv/
__pycache__/
*.pyc
.pytest_cache/

# Backend runtime data: uploads, analysis outputs, sqlite db, and every
# downloaded/fetched dataset (LEVIR-CD, OSCD, any scripts/fetch_* output,
# present or future) -- all documented as scripted re-downloads. Ignore
# every subdirectory of data/ by default and explicitly re-allow the few
# small files that should be tracked.
backend/data/*.db
backend/data/*/
!backend/data/population/
backend/data/population/*
!backend/data/population/.gitkeep

# Model weights (downloaded/trained separately, see README / HANDOFF.md)
backend/models/*
!backend/models/.gitkeep

# Node
frontend/node_modules/
frontend/dist/

# Playwright artifacts
frontend/test-results/
frontend/playwright-report/
frontend/playwright/.cache/
frontend/blob-report/

# Env files (keep .env.example)
.env
backend/.env
frontend/.env

# Editor / OS
.DS_Store
